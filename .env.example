# Copy to .env (git‑ignored) and fill with your own values.
# The frontend reads these into web/app.js — never commit real keys.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase "anon" public key (safe for the browser ONLY with RLS configured)
SUPABASE_ANON_KEY=

# Scraper target — base URL of the public catalog to ingest
CATALOG_BASE_URL=https://example-catalog.invalid
